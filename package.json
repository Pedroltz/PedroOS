{
  "name": "pedroos-95",
  "version": "1.0.0",
  "private": true,
  "description": "PedroOS 95 — portfólio interativo com interface clássica (ferramentas de frontend)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "dotnet run --project src/PedroOS.Web",
    "dev": "npm run build:dev && dotnet run --project src/PedroOS.Web",
    "build": "npm run images && node scripts/build.mjs",
    "build:dev": "npm run images && node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "icons": "node scripts/generate-icons.mjs",
    "cursors": "node scripts/generate-cursors.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/PedroOS.Web/Client/**/*.ts\" \"tests/PedroOS.E2E/**/*.ts\" \"tests/client/**/*.ts\"",
    "test:client": "node scripts/test-client.mjs && node --test tests/client/icon-assets.test.mjs",
    "export:pages": "node scripts/export-static.mjs",
    "test:e2e": "playwright test -c tests/PedroOS.E2E/playwright.config.ts",
    "images": "node scripts/optimize-images.mjs",
    "test:static": "node scripts/test-static.mjs",
    "preview:pages": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "98.css": "^0.1.21",
    "interactjs": "^1.10.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pixelarticons": "^2.4.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
