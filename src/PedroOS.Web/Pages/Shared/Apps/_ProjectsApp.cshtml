@{
    var projects = Portfolio.GetProjects();
}
<div class="app-shell explorer-app" data-projects-app>
    <div class="win95-addressbar"><span>Address</span><span>C:\Projects</span></div>
    <div class="explorer-items-viewport sunken-panel">
        <div class="explorer-items view-large-icons" role="listbox" aria-label="Projetos">
        @foreach (var project in projects)
        {
            <a class="explorer-item" href="/projects/@project.Slug" title="@project.Name">
                <os-icon key="@project.Icon" size="32" alt="" />
                <span class="explorer-item-name">@project.ExecutableName</span>
            </a>
        }
        </div>
    </div>
    <div class="status-bar"><p class="status-bar-field">@projects.Count object(s)</p><p class="status-bar-field">C:\Projects</p></div>
</div>
