@{
    var categories = Portfolio.GetSkillCategories();
    var profile = Portfolio.GetProfile();
    var firstSkill = categories.SelectMany(c => c.Items).FirstOrDefault();
}
<div class="app-shell sysprops-app" data-sysprops-app data-info-tabs>
    <div role="tablist" aria-label="Abas das Propriedades do Sistema" class="info-tabs">
        <button type="button" role="tab" aria-selected="true" data-info-tab="general">Geral</button>
        <button type="button" role="tab" aria-selected="false" tabindex="-1" data-info-tab="dev-manager" aria-label="Gerenciador de Dispositivos">Dispositivos</button>
        @foreach (var cat in categories) { <button type="button" role="tab" aria-selected="false" tabindex="-1" data-info-tab="@cat.Id">@cat.Name</button> }
    </div>
    <section role="tabpanel" class="info-panel" data-info-panel="general">
        <div class="system-general-layout">
            <div class="system-computer-picture"><os-icon key="my-computer" size="48" alt="" /><strong>PedroOS 95</strong></div>
            <div class="system-general-copy">
                <div class="system-general-section"><h3>Sistema:</h3><p>PedroOS 95<br />Edição Portfólio<br />4.00.950</p></div>
                <div class="system-general-section"><h3>Registrado para:</h3><p>@profile.Name<br />@profile.Headline</p><p>19950-OEM-0010295-PEDRO</p></div>
                <div class="system-general-section system-summary"><h3>Computador:</h3><p>ASP.NET Core · .NET 10 LTS<br />@categories.Count subsistemas de competências<br />@categories.Sum(c => c.Items.Count) competências documentadas<br />@Portfolio.GetProjects().Count projetos no portfólio</p></div>
            </div>
        </div>
        <fieldset class="system-subsystems"><legend>Subsistemas instalados</legend><div class="system-actions">@foreach (var cat in categories) { <button type="button" data-info-go="@cat.Id">@cat.Name</button> }</div></fieldset>
        <p class="system-note">Use o Gerenciador de Dispositivos para consultar cada competência.</p>
    </section>
    <section role="tabpanel" class="info-panel system-devices-panel" data-info-panel="dev-manager" hidden>
        <p class="system-note">Selecione um componente para consultar a experiência prática e os projetos relacionados.</p>
        <div class="system-device-layout">
            <nav class="system-device-tree sunken-panel" aria-label="Componentes do sistema"><strong class="system-tree-root">PEDROOS-95</strong>
                @foreach (var cat in categories) {
                    <details open><summary><os-icon key="@cat.Icon" size="16" alt="" />@cat.Name</summary><ul>
                    @foreach (var skill in cat.Items) { <li><button type="button" class="tree-skill-btn" data-skill-select="@skill.Id" aria-pressed="@(skill == firstSkill ? "true" : "false")"><os-icon key="sys" size="16" alt="" /><span>@skill.Name</span></button></li> }
                    </ul></details>
                }
            </nav>
            <div class="system-device-inspector sunken-panel" data-skill-inspector aria-label="Detalhes da competência" tabindex="0">@if (firstSkill is not null) { <partial name="Apps/_SkillDetails" model="firstSkill" /> }</div>
        </div>
        @foreach (var skill in categories.SelectMany(c => c.Items)) { <template data-skill-template="@skill.Id"><partial name="Apps/_SkillDetails" model="skill" /></template> }
    </section>
    @foreach (var cat in categories) {
        <section role="tabpanel" class="info-panel" data-info-panel="@cat.Id" hidden>
            <header class="system-category-heading"><os-icon key="@cat.Icon" size="32" alt="" /><div><h3>@cat.Name</h3><p>@cat.Description</p></div></header>
            <div class="system-skill-cards">@foreach (var skill in cat.Items) { <fieldset><legend>@skill.Name</legend><partial name="Apps/_SkillDetails" model="skill" /></fieldset> }</div>
        </section>
    }
    <footer class="system-dialog-footer"><span data-info-status class="sr-only">Geral</span><div class="system-actions"><button type="button" data-open-app="projects">Projetos</button><button type="button" data-open-app="resume">Currículo</button><button type="button" data-close-fragment aria-label="Fechar janela">OK</button></div></footer>
</div>
