@{
    var githubUrl = "https://github.com/Pedroltz";
    var projects = Portfolio.GetProjects();
    var pinnedProjects = projects.Where(p => p.GitHubPinnedOrder.HasValue).OrderBy(p => p.GitHubPinnedOrder).ToList();
}
<div class="app-shell github-app">
    <div class="win95-menubar" role="menubar" aria-label="Menu do GitHub">
        <span class="win95-menu-item"><u>A</u>rquivo</span>
        <span class="win95-menu-item"><u>E</u>ditar</span>
        <span class="win95-menu-item">E<u>x</u>ibir</span>
        <span class="win95-menu-item">A<u>j</u>uda</span>
    </div>

    <div class="win95-toolbar" role="toolbar" aria-label="Ações do perfil GitHub">
        <a class="toolbar-btn" href="@githubUrl" target="_blank" rel="noopener noreferrer">
            <os-icon key="github" size="16" alt="" />
            <span>Abrir no GitHub Oficial &#8599;</span>
        </a>
        <button type="button" class="toolbar-btn" data-open-app="projects">
            <os-icon key="projects" size="16" alt="" />
            <span>Projetos</span>
        </button>
        <button type="button" class="toolbar-btn" data-open-app="resume">
            <os-icon key="resume" size="16" alt="" />
            <span>Ver Currículo</span>
        </button>
        <button type="button" class="toolbar-btn" data-open-app="linkedin">
            <os-icon key="linkedin" size="16" alt="" />
            <span>Ver LinkedIn</span>
        </button>
    </div>

    <div class="win95-addressbar">
        <label class="addressbar-label">Endereço</label>
        <div class="addressbar-field sunken-panel">
            <os-icon key="github" size="16" alt="" />
            <span>@githubUrl</span>
        </div>
    </div>

    <div class="github-viewport sunken-panel" tabindex="0">
        <div class="github-page">
            <header class="github-banner">
                <div class="github-banner-top">
                    <os-icon key="github" size="48" class="github-avatar" alt="Octocat GitHub" />
                    <div class="github-banner-title">
                        <h2>Pedro Tunin <small class="github-handle">@@Pedroltz</small></h2>
                        <p class="github-headline">Engenheiro de Software &bull; .NET 10 &bull; Python &bull; Linux / DevOps &bull; Sistemas de IA</p>
                        <p class="github-location">Brasil &bull; <a href="@githubUrl" target="_blank" rel="noopener noreferrer" class="github-external-link">github.com/Pedroltz &#8599;</a></p>
                    </div>
                </div>

                <div class="github-cta-buttons">
                    <a class="button win95-btn-primary" href="@githubUrl" target="_blank" rel="noopener noreferrer">
                        Visitar Perfil no GitHub (github.com/Pedroltz) &#8599;
                    </a>
                    <button type="button" data-open-app="projects">
                        Abrir Projetos
                    </button>
                    <button type="button" data-open-app="linkedin">
                        Abrir LinkedIn
                    </button>
                </div>
            </header>

            <fieldset class="win95-fieldset">
                <legend>Projetos fixados no GitHub</legend>
                <div class="github-repos-grid">
                    @foreach (var proj in pinnedProjects)
                    {
                        <div class="github-repo-card sunken-panel" data-github-pinned="@proj.Slug">
                            <div class="github-repo-head">
                                <os-icon key="@proj.Icon" size="16" alt="" />
                                <strong>@proj.Name</strong>
                                <span class="win95-tag" style="margin-left: auto;">Fixado</span>
                            </div>
                            <p class="github-repo-desc">@proj.Summary</p>
                            <div class="project-stack-list">
                                @foreach (var tech in proj.Stack.Take(4))
                                {
                                    <span class="win95-tag">@tech</span>
                                }
                            </div>
                            <div class="github-repo-actions">
                                <button type="button" data-open-app="project" data-arg-slug="@proj.Slug">
                                    Inspecionar no PedroOS
                                </button>
                                <a class="button" href="@proj.RepositoryUrl" target="_blank" rel="noopener noreferrer">
                                    GitHub &#8599;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </fieldset>

            <fieldset class="win95-fieldset">
                <legend>Sobre a Presença no GitHub</legend>
                <p>
                    Mantenedor e autor de projetos open-source e monólitos modulares com foco em arquitetura de backend (.NET 10, ASP.NET Core, Python, FastAPI), aplicações desktop Linux nativas em GTK 4 / libadwaita e infraestrutura conteinerizada.
                </p>
                <p class="muted-note">
                    <em>Dica: Você pode abrir cada projeto em sua janela individual no PedroOS 95 ou navegar diretamente pelo código-fonte no GitHub.</em>
                </p>
            </fieldset>
        </div>
    </div>

    <div class="status-bar">
        <p class="status-bar-field">Concluído — @githubUrl</p>
        <p class="status-bar-field">Zona da Internet do PedroOS</p>
    </div>
</div>
