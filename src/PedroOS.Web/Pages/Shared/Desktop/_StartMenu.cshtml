@{
    var featuredProjects = Portfolio.GetProjects(featuredOnly: true);
}
<nav class="start-menu window" id="start-menu" aria-label="Menu Iniciar" hidden>
    <div class="start-menu-banner" aria-hidden="true">
        <span class="start-menu-banner-text"><strong>PedroOS</strong> 95</span>
    </div>
    <ul class="start-menu-list" role="menu">
        <li class="start-menu-item has-submenu" role="none">
            <button type="button" class="start-menu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                <os-icon key="folder" size="16" alt="" />
                <span class="start-menu-label"><u>P</u>rograms</span>
                <span class="start-menu-arrow" aria-hidden="true">&#9656;</span>
            </button>
            <ul class="start-submenu window" role="menu" aria-label="Programs">
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="explorer" data-arg-path="C:\">
                        <os-icon key="explorer" size="16" alt="" />
                        <span>Windows Explorer</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="projects">
                        <os-icon key="projects" size="16" alt="" />
                        <span>Projects Explorer</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="resume">
                        <os-icon key="resume" size="16" alt="" />
                        <span>WordPad (Resume.doc)</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="iexplore">
                        <os-icon key="iexplore" size="16" alt="" />
                        <span>Internet Explorer</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="minesweeper">
                        <os-icon key="minesweeper" size="16" alt="" />
                        <span>Minesweeper</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="notepad" data-arg-path="C:\AboutMe\Readme.txt">
                        <os-icon key="notepad" size="16" alt="" />
                        <span>Notepad (Readme.txt)</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="terminal">
                        <os-icon key="msdos" size="16" alt="" />
                        <span>MS-DOS Prompt</span>
                    </button>
                </li>
            </ul>
        </li>

        <li class="start-menu-item has-submenu" role="none">
            <button type="button" class="start-menu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                <os-icon key="projects" size="16" alt="" />
                <span class="start-menu-label">Pr<u>o</u>jects</span>
                <span class="start-menu-arrow" aria-hidden="true">&#9656;</span>
            </button>
            <ul class="start-submenu window" role="menu" aria-label="Projects">
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="projects">
                        <os-icon key="projects" size="16" alt="" />
                        <span>All Projects (Projects.exe)</span>
                    </button>
                </li>
                <li class="start-menu-separator" role="separator"></li>
                @foreach (var project in featuredProjects)
                {
                    <li role="none">
                        <button type="button" class="start-menu-action" role="menuitem" data-open-app="project" data-arg-slug="@project.Slug">
                            <os-icon key="@project.Icon" size="16" alt="" />
                            <span>@project.Name</span>
                        </button>
                    </li>
                }
            </ul>
        </li>

        <li class="start-menu-item has-submenu" role="none">
            <button type="button" class="start-menu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                <os-icon key="doc" size="16" alt="" />
                <span class="start-menu-label"><u>D</u>ocuments</span>
                <span class="start-menu-arrow" aria-hidden="true">&#9656;</span>
            </button>
            <ul class="start-submenu window" role="menu" aria-label="Documents">
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="resume">
                        <os-icon key="resume" size="16" alt="" />
                        <span>Resume.doc (Currículo)</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="resume" data-arg-section="experience">
                        <os-icon key="doc" size="16" alt="" />
                        <span>Career.doc (Experiência)</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="notepad" data-arg-path="C:\AboutMe\Readme.txt">
                        <os-icon key="text" size="16" alt="" />
                        <span>Readme.txt</span>
                    </button>
                </li>
                <li class="start-menu-separator" role="separator"></li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="github">
                        <os-icon key="github" size="16" alt="" />
                        <span>GitHub (@@Pedroltz)</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="linkedin">
                        <os-icon key="linkedin" size="16" alt="" />
                        <span>LinkedIn (pedrotunin)</span>
                    </button>
                </li>
            </ul>
        </li>

        <li class="start-menu-item has-submenu" role="none">
            <button type="button" class="start-menu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                <os-icon key="control-panel" size="16" alt="" />
                <span class="start-menu-label"><u>S</u>ettings</span>
                <span class="start-menu-arrow" aria-hidden="true">&#9656;</span>
            </button>
            <ul class="start-submenu window" role="menu" aria-label="Settings">
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="sysprops">
                        <os-icon key="system" size="16" alt="" />
                        <span>System Properties (Skills)</span>
                    </button>
                </li>
                <li role="none">
                    <button type="button" class="start-menu-action" role="menuitem" data-open-app="display">
                        <os-icon key="display" size="16" alt="" />
                        <span>Display Properties</span>
                    </button>
                </li>
            </ul>
        </li>

        <li class="start-menu-item" role="none">
            <button type="button" class="start-menu-action" role="menuitem" data-open-app="find">
                <os-icon key="find" size="16" alt="" />
                <span class="start-menu-label"><u>F</u>ind Files or Projects...</span>
            </button>
        </li>

        <li class="start-menu-item" role="none">
            <button type="button" class="start-menu-action" role="menuitem" data-open-app="about">
                <os-icon key="help" size="16" alt="" />
                <span class="start-menu-label"><u>A</u>bout PedroOS 95</span>
            </button>
        </li>

        <li class="start-menu-item" role="none">
            <button type="button" class="start-menu-action" role="menuitem" data-open-app="run">
                <os-icon key="run" size="16" alt="" />
                <span class="start-menu-label"><u>R</u>un...</span>
            </button>
        </li>

        <li class="start-menu-separator" role="separator"></li>

        <li class="start-menu-item" role="none">
            <button type="button" class="start-menu-action" role="menuitem" data-open-app="shutdown">
                <os-icon key="shutdown" size="16" alt="" />
                <span class="start-menu-label">Sh<u>u</u>t Down...</span>
            </button>
        </li>
    </ul>
</nav>
