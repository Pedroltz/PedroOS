@{
    var desktopItems = new (string Id, string Label, string Icon, string Action, string Target, string? ArgKey, string? ArgValue)[]
    {
        ("icon-my-computer", "Meu Computador", "my-computer", "app", "explorer", "path", @"C:\"),
        ("icon-explorer", "Explorador de Arquivos", "explorer", "app", "explorer", "path", @"C:\"),
        ("icon-projects", "Projetos", "projects", "app", "projects", null, null),
        ("icon-ofizzy", "Ofizzy", "ofizzy", "app", "project", "slug", "ofizzy"),
        ("icon-rdp", "RDP Session Manager", "rdp-session-manager", "app", "project", "slug", "rdp-session-manager"),
        ("icon-resume", "Currículo", "resume", "app", "resume", null, null),
        ("icon-sysprops", "Propriedades do Sistema", "system", "app", "sysprops", null, null),
        ("icon-iexplore", "Navegador PedroOS", "iexplore", "app", "iexplore", null, null),
        ("icon-minesweeper", "Campo Minado", "minesweeper", "app", "minesweeper", null, null),
        ("icon-readme", "Leia-me", "text", "app", "notepad", "path", @"C:\SobreMim\Leia-me.txt"),
        ("icon-msdos", "Terminal PedroOS", "msdos", "app", "terminal", null, null),
        ("icon-github", "GitHub", "github", "app", "github", null, null),
        ("icon-linkedin", "LinkedIn", "linkedin", "app", "linkedin", null, null),
        ("icon-recycle", "Lixeira", "recycle-bin", "app", "explorer", "path", @"C:\PEDROOS"),
    };
}
<nav class="desktop-icons" id="desktop-icons" aria-label="Atalhos da área de trabalho">
    @foreach (var item in desktopItems)
    {
        if (item.Action == "url")
        {
            <a class="desktop-icon"
               id="@item.Id"
               href="@item.Target"
               target="_blank"
               rel="noopener noreferrer"
               data-desktop-icon
               data-action="url"
               data-url="@item.Target"
               aria-label="@item.Label (abre em nova aba)">
                <os-icon key="@item.Icon" size="32" alt="" draggable="false" />
                <span class="desktop-icon-label">@item.Label</span>
            </a>
        }
        else
        {
            <button type="button"
                    class="desktop-icon"
                    id="@item.Id"
                    data-desktop-icon
                    data-action="app"
                    data-app-id="@item.Target"
                    data-arg-key="@item.ArgKey"
                    data-arg-value="@item.ArgValue"
                    aria-label="@item.Label">
                <os-icon key="@item.Icon" size="32" alt="" draggable="false" />
                <span class="desktop-icon-label">@item.Label</span>
            </button>
        }
    }
</nav>
