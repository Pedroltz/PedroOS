@{
    var desktopItems = new (string Id, string Label, string Icon, string Action, string Target, string? ArgKey, string? ArgValue)[]
    {
        ("icon-my-computer", "My Computer", "my-computer", "app", "explorer", "path", @"C:\"),
        ("icon-explorer", "Windows Explorer", "explorer", "app", "explorer", "path", @"C:\"),
        ("icon-projects", "Projects", "projects", "app", "projects", null, null),
        ("icon-ofizzy", "Ofizzy", "ofizzy", "app", "project", "slug", "ofizzy"),
        ("icon-rdp", "RDP Session Manager", "rdp-session-manager", "app", "project", "slug", "rdp-session-manager"),
        ("icon-resume", "Resume.doc", "resume", "app", "resume", null, null),
        ("icon-sysprops", "System Properties", "system", "app", "sysprops", null, null),
        ("icon-iexplore", "Internet Explorer", "iexplore", "app", "iexplore", null, null),
        ("icon-minesweeper", "Minesweeper", "minesweeper", "app", "minesweeper", null, null),
        ("icon-readme", "Readme.txt", "text", "app", "notepad", "path", @"C:\AboutMe\Readme.txt"),
        ("icon-github", "GitHub", "github", "app", "github", null, null),
        ("icon-linkedin", "LinkedIn", "linkedin", "app", "linkedin", null, null),
        ("icon-recycle", "Recycle Bin", "recycle-bin", "app", "explorer", "path", @"C:\PEDROOS"),
    };
}
<nav class="desktop-icons" id="desktop-icons" aria-label="Atalhos da área de trabalho">
    @foreach (var item in desktopItems)
    {
        if (item.Action == "url")
        {
            <a class="desktop-icon"
               id="@item.Id"
               href="@item.Target"
               target="_blank"
               rel="noopener noreferrer"
               data-desktop-icon
               data-action="url"
               data-url="@item.Target"
               aria-label="@item.Label (abre em nova aba)">
                <img class="pixel-icon" src="@Icons.GetPath(item.Icon, 32)" width="32" height="32" alt="" draggable="false" />
                <span class="desktop-icon-label">@item.Label</span>
            </a>
        }
        else
        {
            <button type="button"
                    class="desktop-icon"
                    id="@item.Id"
                    data-desktop-icon
                    data-action="app"
                    data-app-id="@item.Target"
                    data-arg-key="@item.ArgKey"
                    data-arg-value="@item.ArgValue"
                    aria-label="@item.Label">
                <img class="pixel-icon" src="@Icons.GetPath(item.Icon, 32)" width="32" height="32" alt="" draggable="false" />
                <span class="desktop-icon-label">@item.Label</span>
            </button>
        }
    }
</nav>
