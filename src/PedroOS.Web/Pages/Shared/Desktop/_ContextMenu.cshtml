<div class="context-menu window" id="desktop-context-menu" role="menu" aria-label="Menu de contexto da área de trabalho" hidden>
    <button type="button" class="context-menu-item" role="menuitem" data-open-app="explorer" data-arg-path="C:\">
        Abrir o Explorador de Arquivos
    </button>
    <button type="button" class="context-menu-item" role="menuitem" data-open-app="projects">
        Abrir Projetos
    </button>
    <button type="button" class="context-menu-item" role="menuitem" data-open-app="resume">
        Abrir Currículo
    </button>
    <div class="context-menu-separator" role="separator"></div>
    <button type="button" class="context-menu-item" role="menuitem" data-context-action="arrange">
        Organizar ícones por nome
    </button>
    <button type="button" class="context-menu-item" role="menuitem" data-context-action="cascade">
        Organizar janelas em cascata
    </button>
    <button type="button" class="context-menu-item" role="menuitem" data-context-action="refresh">
        Atualizar área de trabalho
    </button>
    <div class="context-menu-separator" role="separator"></div>
    <button type="button" class="context-menu-item" role="menuitem" data-open-app="display">
        Propriedades de Vídeo
    </button>
    <button type="button" class="context-menu-item" role="menuitem" data-open-app="sysprops">
