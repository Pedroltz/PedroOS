@page
@model ErrorModel
@{ ViewData["Title"] = "Erro — PedroOS 95"; }
<div class="window" style="max-width: 480px; margin: 40px auto; padding: 12px;">
    <h1 style="font-size: 22px;">PedroOS 95</h1>
    <h2 style="font-size: 16px;">Não foi possível concluir a solicitação.</h2>
    <p>Tente novamente ou volte à área de trabalho.</p>
    @if (Model.ShowRequestId)
    { <p>Identificação da solicitação: <code>@Model.RequestId</code></p> }
    <a class="button" href="/">Voltar ao PedroOS 95</a>
</div>
